---
/**
 * One of the 39 categories. The coloured spine places it on the complexity
 * ramp at a glance, so a grid of cards reads as a distribution, not a list.
 */
import { routes } from '../lib/paths.ts'
import { PATTERN_COMPLEXITY } from '../lib/complexity.ts'
import { statsForPattern } from '../lib/problems.ts'
import type { Pattern } from '../data/taxonomy.ts'
import ComplexityBadge from './ComplexityBadge.astro'
import CompanyChip from './CompanyChip.astro'

interface Props {
  pattern: Pattern
  /** Position in the group, used as the reading order marker. */
  index: number
}

const { pattern, index } = Astro.props
const complexity = PATTERN_COMPLEXITY[pattern.id] ?? 'on'
const stats = statsForPattern(pattern.id)
---

<a
  href={routes.pattern(pattern.id)}
  class="spine group border-line-soft bg-bg-raised hover:border-line relative flex flex-col gap-3 rounded-card border p-5 pl-6 transition-[transform,border-color] duration-200 hover:-translate-y-0.5 motion-reduce:hover:translate-y-0"
  style={`--spine-color: var(--color-${complexity})`}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-[15px] leading-snug">{pattern.name}</h3>
    <span class="tabular text-ink-faint mt-0.5 shrink-0 text-[11px]">
      {String(index).padStart(2, '0')}
    </span>
  </div>

  <p class="text-ink-muted grow text-[13px] leading-relaxed">{pattern.tagline}</p>

  <div class="flex flex-wrap items-center gap-1.5">
    <ComplexityBadge id={complexity} />
    <span class="tabular text-ink-faint text-[11px]">{stats.total} problems</span>
  </div>

  {
    stats.topCompanies.length > 0 && (
      <div class="border-line-soft flex flex-wrap items-center gap-1 border-t pt-3">
        {stats.topCompanies.slice(0, 4).map(({ company }) => (
          <CompanyChip companyId={company.id} />
        ))}
      </div>
    )
  }
</a>
