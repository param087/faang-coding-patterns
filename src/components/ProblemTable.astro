---
/**
 * The practice table: a real `<table>` so it is scannable and navigable by
 * keyboard and screen reader, with progress checkboxes that persist locally.
 */
import { problemBySlug, askedBy, type Problem } from '../lib/problems.ts'
import { external, routes } from '../lib/paths.ts'
import DifficultyMeter from './DifficultyMeter.astro'
import CompanyChip from './CompanyChip.astro'

interface Props {
  slugs: string[]
  caption: string
  /** Slugs that have a written solution page. */
  solved?: Set<string>
}

const { slugs, caption, solved = new Set<string>() } = Astro.props
const rows = slugs
  .map((slug) => problemBySlug.get(slug))
  .filter((p): p is Problem => p !== undefined)
---

<div class="border-line-soft rounded-card my-6 overflow-hidden border">
  <table class="w-full border-collapse text-left text-[13px]">
    <caption class="border-line-soft text-ink-muted border-b px-4 py-2.5 text-left text-[12px] font-medium">
      {caption}
      <span class="text-ink-faint tabular ml-1">· {rows.length}</span>
    </caption>
    <thead>
      <tr class="text-ink-faint border-line-soft border-b text-[11px] tracking-wide uppercase">
        <th scope="col" class="w-9 py-2 pl-4"><span class="sr-only">Done</span></th>
        <th scope="col" class="py-2">Problem</th>
        <th scope="col" class="w-24 py-2">Difficulty</th>
        <th scope="col" class="py-2">Asked by</th>
        <th scope="col" class="w-20 py-2 pr-4 text-right">Links</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((p) => {
          const companies = askedBy(p).filter((c) => c.company.core).slice(0, 4)
          return (
            <tr class="border-line-soft hover:bg-bg-raised/60 border-b transition-colors last:border-b-0">
              <td class="py-2.5 pl-4 align-middle">
                <input
                  type="checkbox"
                  class="progress-box accent-onlogn h-3.5 w-3.5 cursor-pointer align-middle"
                  data-slug={p.slug}
                  aria-label={`Mark ${p.title} as done`}
                />
              </td>
              <td class="py-2.5 pr-3 align-middle">
                <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                  <span class="tabular text-ink-faint text-[11px]">{p.id}</span>
                  {solved.has(p.slug) ? (
                    <a href={routes.problem(p.slug)} class="hover:text-onlogn font-medium">
                      {p.title}
                    </a>
                  ) : (
                    <span class="text-ink-muted">{p.title}</span>
                  )}
                  {p.blind75 && (
                    <span class="border-line text-ink-faint rounded-[3px] border px-1 text-[10px]">
                      B75
                    </span>
                  )}
                  {p.nc150 && (
                    <span class="border-line text-ink-faint rounded-[3px] border px-1 text-[10px]">
                      NC150
                    </span>
                  )}
                  {p.premium && (
                    <span
                      class="border-on2/40 text-on2 rounded-[3px] border px-1 text-[10px]"
                      title="LeetCode Premium — statement not public"
                    >
                      Premium
                    </span>
                  )}
                </span>
              </td>
              <td class="py-2.5 align-middle">
                <DifficultyMeter difficulty={p.difficulty} />
              </td>
              <td class="py-2.5 align-middle">
                {companies.length ? (
                  <span class="flex flex-wrap items-center gap-1">
                    {companies.map((c) => (
                      <CompanyChip companyId={c.company.id} frequency={c.frequency} />
                    ))}
                  </span>
                ) : (
                  <span class="text-ink-faint text-[11px]">—</span>
                )}
              </td>
              <td class="py-2.5 pr-4 text-right align-middle whitespace-nowrap">
                <a
                  href={external.leetcode(p.slug)}
                  class="text-ink-faint hover:text-ink text-[11px]"
                  rel="noopener"
                >
                  LC
                </a>
                {p.video && (
                  <>
                    <span class="text-ink-faint mx-1 text-[11px]">·</span>
                    <a
                      href={external.youtube(p.video)}
                      class="text-ink-faint hover:text-ink text-[11px]"
                      rel="noopener"
                      title="NeetCode walkthrough"
                    >
                      Video
                    </a>
                  </>
                )}
              </td>
            </tr>
          )
        })
      }
    </tbody>
  </table>
</div>
