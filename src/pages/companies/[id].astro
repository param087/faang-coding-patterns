---
import { readFile } from 'node:fs/promises'
import path from 'node:path'
import Base from '../../layouts/Base.astro'
import CompanyChip from '../../components/CompanyChip.astro'
import ProblemTable from '../../components/ProblemTable.astro'
import { companies, problems, problemBySlug } from '../../lib/problems.ts'
import { PATTERN_BY_ID, PATTERNS } from '../../data/taxonomy.ts'
import { PATTERN_COMPLEXITY } from '../../lib/complexity.ts'
import { routes } from '../../lib/paths.ts'
import { WINDOWS, COMPANY_SNAPSHOT_DATE } from '../../../scripts/sources.ts'

export async function getStaticPaths() {
  // Only companies with enough data to say anything. The rest live in the
  // explorer, where a thin result set reads as a filter rather than a page.
  return companies
    .filter((c) => c.core || c.recent >= 3)
    .map((company) => ({ params: { id: company.id }, props: { company } }))
}

const { company } = Astro.props

/** Read the per-company frequency map the explorer lazy-loads. */
const raw = JSON.parse(
  await readFile(
    path.join(process.cwd(), 'public', 'data', 'companies', `${company.id}.json`),
    'utf8'
  )
) as Record<string, (number | null)[]>

const SIX = WINDOWS.indexOf('six-months')
const asked = Object.entries(raw)
  .map(([slug, windows]) => ({ slug, frequency: windows[SIX] ?? windows[WINDOWS.indexOf('all')] ?? 0 }))
  .filter((x) => problemBySlug.has(x.slug))
  .sort((a, b) => b.frequency - a.frequency)

const top = asked.slice(0, 25).map((x) => x.slug)

/**
 * Pattern skew: how much more (or less) of this company's question bank sits
 * in a pattern, compared with the whole index. This is the number worth
 * knowing — "Google is 1.8x the baseline on graphs" changes what you drill.
 */
const askedSet = new Set(asked.map((x) => x.slug))
const companyByPattern = new Map<string, number>()
for (const slug of askedSet) {
  const p = problemBySlug.get(slug)
  if (p?.pattern) companyByPattern.set(p.pattern, (companyByPattern.get(p.pattern) ?? 0) + 1)
}
const globalByPattern = new Map<string, number>()
for (const p of problems) {
  if (p.pattern) globalByPattern.set(p.pattern, (globalByPattern.get(p.pattern) ?? 0) + 1)
}
const globalTotal = problems.filter((p) => p.pattern).length

const skew = PATTERNS.map((pattern) => {
  const mine = companyByPattern.get(pattern.id) ?? 0
  const theirs = globalByPattern.get(pattern.id) ?? 0
  if (mine < 3 || !theirs) return null
  const ratio = mine / askedSet.size / (theirs / globalTotal)
  return { pattern, count: mine, ratio }
})
  .filter((x): x is { pattern: (typeof PATTERNS)[number]; count: number; ratio: number } => x !== null)
  .sort((a, b) => b.ratio - a.ratio)

const over = skew.slice(0, 6)
const difficulties = (['Easy', 'Medium', 'Hard'] as const).map((d) => ({
  d,
  n: [...askedSet].filter((s) => problemBySlug.get(s)?.difficulty === d).length,
}))
---

<Base title={company.name} description={`What ${company.name} asks in coding rounds, by pattern and frequency.`}>
  <article class="py-10 lg:py-14">
    <nav class="text-ink-faint mb-6 text-[12px]" aria-label="Breadcrumb">
      <a href={routes.companies()} class="hover:text-ink">Companies</a>
      <span class="mx-1.5">/</span>
      <span class="text-ink-muted">{company.name}</span>
    </nav>

    <header class="border-line-soft flex flex-wrap items-center gap-4 border-b pb-8">
      <CompanyChip companyId={company.id} size="md" />
      <h1 class="text-[clamp(2rem,4.5vw,3rem)]">{company.name}</h1>
    </header>

    <!-- Five stats, so five columns — a four-column grid orphans "Hard". -->
    <dl class="border-line-soft grid grid-cols-2 gap-6 border-b py-6 sm:grid-cols-3 lg:grid-cols-5">
      <div>
        <dt class="text-ink-faint text-[11px] tracking-wide uppercase">Last 6 months</dt>
        <dd class="tabular mt-1 text-2xl font-semibold">{company.recent}</dd>
      </div>
      <div>
        <dt class="text-ink-faint text-[11px] tracking-wide uppercase">All time</dt>
        <dd class="tabular mt-1 text-2xl font-semibold">{company.total}</dd>
      </div>
      {
        difficulties.map(({ d, n }) => (
          <div>
            <dt class="text-ink-faint text-[11px] tracking-wide uppercase">{d}</dt>
            <dd class="tabular mt-1 text-2xl font-semibold">{n}</dd>
          </div>
        ))
      }
    </dl>

    {
      over.length > 0 && (
        <section class="border-line-soft border-b py-8">
          <h2 class="text-[22px]">What they over-index on</h2>
          <p class="text-ink-muted mt-2 max-w-[62ch] text-[13px] leading-relaxed">
            How much of {company.name}'s tagged bank sits in each pattern, against that
            pattern's share of the whole index. Above 1.0 means they lean on it more
            than average — that is where the extra hour goes.
          </p>
          <ul class="mt-6 space-y-2">
            {over.map(({ pattern, count, ratio }) => {
              const c = PATTERN_COMPLEXITY[pattern.id] ?? 'on'
              return (
                <li>
                  <a
                    href={routes.pattern(pattern.id)}
                    class="spine border-line-soft bg-bg-raised hover:border-line rounded-card flex flex-wrap items-center gap-x-4 gap-y-1 border py-2.5 pr-4 pl-4 transition-colors"
                    style={`--spine-color: var(--color-${c})`}
                  >
                    <span class="min-w-[14rem] flex-1 text-[14px]">
                      {PATTERN_BY_ID.get(pattern.id)?.name}
                    </span>
                    <span class="bg-line-soft h-1.5 w-32 overflow-hidden rounded-full">
                      <span
                        class="block h-full rounded-full"
                        style={`width:${Math.min(100, (ratio / 2.5) * 100)}%; background: var(--color-${c})`}
                      />
                    </span>
                    <span class="tabular w-12 text-right text-[13px] font-medium">
                      {ratio.toFixed(1)}×
                    </span>
                    <span class="tabular text-ink-faint w-20 text-right text-[12px]">
                      {count} problems
                    </span>
                  </a>
                </li>
              )
            })}
          </ul>
        </section>
      )
    }

    <section class="py-8">
      <h2 class="text-[22px]">Most asked</h2>
      <p class="text-ink-muted mt-2 max-w-[62ch] text-[13px] leading-relaxed">
        Top {top.length} by six-month frequency, from the {COMPANY_SNAPSHOT_DATE} snapshot.
        {
          company.recent < 20 && (
            <>
              {' '}
              <strong class="text-on2">
                The data here is thin — {company.recent} problems in the recent window.
              </strong>{' '}
              Read it as a hint, not a study plan.
            </>
          )
        }
      </p>
      <ProblemTable slugs={top} caption={`Most asked at ${company.name}`} />
    </section>

    <p class="text-ink-faint text-[12px]">
      <a href={`${routes.explorer()}?c=${company.id}`} class="hover:text-ink underline underline-offset-2">
        Open {company.name} in the explorer →
      </a>
    </p>
  </article>
</Base>

<script>
  import { hydrateCheckboxes } from '../../lib/progress.ts'
  hydrateCheckboxes()
</script>
