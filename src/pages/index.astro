---
import Base from '../layouts/Base.astro'
import PatternCard from '../components/PatternCard.astro'
import ConstraintInstrument from '../components/ConstraintInstrument.tsx'
import { patternsByGroup, PATTERNS } from '../data/taxonomy.ts'
import { PATTERN_COMPLEXITY } from '../lib/complexity.ts'
import { problems, companies, coreCompanies } from '../lib/problems.ts'
import CompanyChip from '../components/CompanyChip.astro'
import { routes } from '../lib/paths.ts'

const groups = patternsByGroup()

// The instrument names the patterns each complexity class buys you.
const patternsByComplexity: Record<string, string[]> = {}
for (const p of PATTERNS) {
  const c = PATTERN_COMPLEXITY[p.id] ?? 'on'
  ;(patternsByComplexity[c] ??= []).push(p.name)
}

const classified = problems.filter((p) => p.pattern).length
let counter = 0
---

<Base
  title="home"
  description="Every category of coding problem a FAANG SDE-2 interview can ask — the pattern that solves it, a tested Python template, and which companies actually ask it."
>
  <!-- Hero: the thesis, not a stat block. -->
  <section class="relative isolate">
    <div class="graph-paper pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="grid items-start gap-12 py-16 lg:grid-cols-[1.15fr_1fr] lg:gap-16 lg:py-24">
      <div>
        <p class="text-onlogn mb-5 text-[11px] tracking-[0.18em] uppercase">
          FAANG SDE-2 · coding round
        </p>
        <h1 class="text-[clamp(2.6rem,7vw,4.5rem)]">
          Read the<br />constraints<br />first.
        </h1>
        <p class="text-ink-muted mt-7 max-w-[46ch] text-[15px] leading-relaxed">
          The bound on <span class="tabular text-ink">n</span> tells you the complexity you can
          afford, and the complexity tells you which handful of patterns are even in play. That
          is the whole move. This is every pattern a round can test, sorted by what it costs.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href={routes.patterns()}
            class="bg-ink text-bg rounded-chip px-4 py-2.5 text-[13px] font-semibold transition-opacity hover:opacity-85"
          >
            Browse {PATTERNS.length} patterns
          </a>
          <a
            href={routes.explorer()}
            class="border-line text-ink hover:bg-bg-raised rounded-chip border px-4 py-2.5 text-[13px] font-medium transition-colors"
          >
            Filter by company
          </a>
        </div>

        <dl class="border-line-soft mt-10 grid max-w-lg grid-cols-3 gap-6 border-t pt-6">
          <div>
            <dt class="text-ink-faint text-[11px] tracking-wide uppercase">Patterns</dt>
            <dd class="tabular mt-1 text-2xl font-semibold">{PATTERNS.length}</dd>
          </div>
          <div>
            <dt class="text-ink-faint text-[11px] tracking-wide uppercase">Problems mapped</dt>
            <dd class="tabular mt-1 text-2xl font-semibold">{classified.toLocaleString()}</dd>
          </div>
          <div>
            <dt class="text-ink-faint text-[11px] tracking-wide uppercase">Companies</dt>
            <dd class="tabular mt-1 text-2xl font-semibold">{companies.length}</dd>
          </div>
        </dl>
      </div>

      <div class="space-y-6">
        <ConstraintInstrument client:load patternsByComplexity={patternsByComplexity} />

        <!--
          The company data, stated up front. These six get badge columns on
          every problem row; the other 653 are in the explorer.
        -->
        <div class="border-line-soft rounded-card border p-5">
          <div class="mb-4 flex items-baseline justify-between gap-3">
            <h2 class="text-ink-muted text-[11px] tracking-[0.14em] uppercase">Tagged by</h2>
            <a href={routes.companies()} class="text-ink-faint hover:text-ink text-[12px]">
              All {companies.length} companies →
            </a>
          </div>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-3 sm:grid-cols-3">
            {
              coreCompanies.map((c) => (
                <li>
                  <a
                    href={routes.company(c.id)}
                    class="group flex items-center gap-2.5"
                    title={`${c.recent} problems tagged in the last 6 months`}
                  >
                    <CompanyChip companyId={c.id} size="md" />
                    <span class="min-w-0">
                      <span class="group-hover:text-ink text-ink-muted block truncate text-[13px] transition-colors">
                        {c.name}
                      </span>
                      <span class="tabular text-ink-faint block text-[11px]">
                        {c.recent} problems
                      </span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- The 39, grouped. Spines colour-code each card's complexity class. -->
  <section id="patterns" class="pb-8">
    {
      groups.map(({ group, patterns }) => (
        <div class="border-line-soft border-t py-12">
          <div class="mb-8 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <h2 class="text-[22px]">{group.name}</h2>
            <p class="text-ink-muted max-w-[52ch] text-[13px] leading-relaxed">{group.blurb}</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {patterns.map((pattern) => (
              <div data-complexity={PATTERN_COMPLEXITY[pattern.id] ?? 'on'}>
                <PatternCard pattern={pattern} index={++counter} />
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </section>
</Base>

<script>
  // The instrument dims patterns you cannot afford at the selected bound.
  // Plain DOM on purpose: the grid is 39 static cards and needs no framework.
  const cards = () => document.querySelectorAll<HTMLElement>('[data-complexity]')
  document.addEventListener('complexity:select', (event) => {
    const id = (event as CustomEvent<string | null>).detail
    for (const card of cards()) {
      const match = id === null || card.dataset.complexity === id
      card.style.opacity = match ? '1' : '0.28'
      card.style.transition = 'opacity 180ms ease'
    }
  })
</script>
