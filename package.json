{
  "name": "faang-coding-patterns",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Every category of coding problem a FAANG SDE-2 interview can ask, with concepts, tested Python templates and full solutions, labelled by difficulty and by which companies actually ask them.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "data:fetch": "tsx scripts/fetch-data.ts",
    "data:build": "tsx scripts/build-index.ts",
    "data:logos": "tsx scripts/fetch-logos.ts",
    "data:all": "npm run data:fetch && npm run data:build && npm run data:logos",
    "check:links": "tsx scripts/check-links.ts --sample 60",
    "test:py": "./.venv/bin/python -m pytest -q",
    "lint:py": "./.venv/bin/ruff check code solutions",
    "gate": "bash scripts/gate.sh"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "simple-icons": "^16.28.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
